# 后端服务端口
PORT=8080
# PostgreSQL 连接配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=hrms
# Docker Compose 使用的数据库密码（docker-compose.yml 引用，勿硬编码）
POSTGRES_PASSWORD=your_password
# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=dev-secret-change-me
# Token 过期时间（小时）
TOKEN_EXPIRE_HOURS=24
