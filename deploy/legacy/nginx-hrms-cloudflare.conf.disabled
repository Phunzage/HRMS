# Cloudflare 回源入口：用户 → Cloudflare → 8443（绕过阿里云 80/443 备案拦截）
# 回源用 Full(strict) 模式，源站使用自签名证书（/etc/nginx/ssl/hrms-selfsigned.*）
# 按 Host 分发到对应公司后端；与 sites-available/hrms 保持相同 CORS / updates 配置模式

# ---------- 主站 phunzage.fun（后端 8080） ----------
server {
    listen 8443 ssl;
    server_name phunzage.fun www.phunzage.fun;
    client_max_body_size 50m;

    ssl_certificate /etc/nginx/ssl/hrms-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/hrms-selfsigned.key;

    root /opt/hrms/web;
    index index.html;

    # CORS：桌面端 file:// 与 Android WebView 跨源访问
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Access-Control-Max-Age 86400 always;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # API 预检直接返回 204
        if ($request_method = OPTIONS) { return 204; }
    }

    location /updates/ {
        alias /opt/hrms/updates/;
        add_header Content-Disposition 'attachment; filename="$1"';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ---------- testco test.phunzage.fun（后端 8081） ----------
server {
    listen 8443 ssl;
    server_name test.phunzage.fun;
    client_max_body_size 50m;

    ssl_certificate /etc/nginx/ssl/hrms-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/hrms-selfsigned.key;

    root /opt/hrms/web-testco;
    index index.html;

    # CORS：桌面端 file:// 与 Android WebView 跨源访问
    add_header Access-Control-Allow-Origin * always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Access-Control-Max-Age 86400 always;

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        if ($request_method = OPTIONS) { return 204; }
    }

    location /updates/ {
        alias /opt/hrms/updates/;
        add_header Content-Disposition 'attachment; filename="$1"';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
